# Copiar este archivo a .env.local y completar los valores reales.
# Mientras no se completen, el proyecto sigue andando en modo mock
# (pagos simulados con los botones de demo, mails logueados por consola).

# --- Supabase (OBLIGATORIO, sin esto la app no arranca) ---
# Project Settings → API en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Acceso al panel /admin (OBLIGATORIO antes de usar con pacientes reales) ---
# Sin estas dos variables, /admin queda BLOQUEADO por completo (falla cerrado,
# no abierto). Elegí un usuario/contraseña reales — esto es lo único que hoy
# protege los datos de los pacientes.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Mercado Pago (Checkout Pro) ---
# Access Token de https://www.mercadopago.com.ar/developers/panel
# Usar el de PRUEBA mientras se testea, el de PRODUCCIÓN cuando esté todo listo.
MERCADOPAGO_ACCESS_TOKEN=

# "production" cuando se use el Access Token real de Juan; cualquier otro valor (o vacío) usa sandbox.
MERCADOPAGO_ENV=

# --- URL pública del sitio (para los back_urls y el webhook de Mercado Pago) ---
# En local, Mercado Pago necesita una URL pública para poder pegarle al webhook:
# usar ngrok (https://ngrok.com) y poner acá la URL que da, ej: https://abcd1234.ngrok-free.app
# En producción: el dominio real, ej: https://juanzyla.com.ar
APP_BASE_URL=http://localhost:3000

# --- Envío de mails (SMTP) ---
# Ejemplo con Hostinger (el mismo que se usa en MiPerfil.ar):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Cron de recordatorios (GitHub Actions -> /api/cron/recordatorios) ---
# Secret largo y random — sin esto, la ruta queda bloqueada (falla cerrado).
# Tiene que ser EL MISMO valor que el secret CRON_SECRET del repo en GitHub.
CRON_SECRET=

# --- Aviso de nueva reserva confirmada (a quién le llega, no un recordatorio) ---
# Se manda una sola vez, cuando el pago se confirma. Sin estas dos, no se
# manda a nadie (no rompe nada, solo loguea un warning).
DOCTOR_NOTIFICATION_EMAIL=
SECRETARY_NOTIFICATION_EMAIL=
